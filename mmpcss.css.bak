html, body, div, span, applet, object, iframe, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, abbr, acronym, address, big, cite, code, del, dfn, em, font, img, ins, kbd, q, s, samp, small, strike, strong, sub, sup, tt, var, b, u, i, center, dl, dt, dd, ol, ul, li, fieldset, form, label, legend, caption {
    margin: 0;
    padding: 0;
    border: 0;
    outline: 0;
    font-size: 100%;
    vertical-align: baseline;
    background: transparent;
}
html{
	width:100%}
@font-face {
	font-family:"San Francisco Bold";
	src: url("San Francisco Bold.otf");}
@font-face {
	font-family:"San Francisco";
	src: url("San Francisco.otf");}
@font-face {
	font-family:MooLahLah-Regular;
	src: url("MooLahLah-Regular.ttf")
}
ol.topNavOl {
	list-style-type: none;
	text-align: center;
	background-color: black;
	padding: 8px;} 	
li.topNav{
	display: inline;
	padding: 12px;
	font-size: 12px;}
li.classname{
	display: inline;
	color: white;
	font-size: 13px;
	font-family: "San Francisco Bold";}
a:link.nav {
	color:white; 
	text-decoration: none;}
a:visited.nav {
	color: #D3D3D3;}
h1{
	font-family: "San Francisco Bold";
	font-size: 25px;
	text-align: center;}
body {
	background-color: white;
	color: black;
	font-family: "San Francisco";
}
div.plusSpace{
	margin: 2em;}
div.centerDiv{
	margin: auto;
	text-align: center;}
a:link.media {
	color:black; 
	text-decoration: none;}
a:visited.media {
	color: gray;}
a:link.button {
	color:black; 
	text-decoration: none;}
a:visited.button {
	color: gray;}
.button{
	border-radius: 4px;
	padding: 3px;}
footer{
	text-align: center;
	bottom: 0;
	left: 0;
	border: 3px solid black;
	padding: 0px;
	background-color: black;
	color: white;
	font-family: "San Francisco";
	}
footer.shortpage{
	position: fixed;
	width: 100%;}
.bigtext{
	font-size: 100px;
	font-family: "MooLahLah-Regular";}