html, body, div, span, applet, object, iframe, h1, h2, h3, h4, h5, h6, p, blockquote, pre, a, abbr, acronym, address, big, cite, code, del, dfn, em, font, img, ins, kbd, q, s, samp, small, strike, strong, sub, sup, tt, var, b, u, i, center, dl, dt, dd, ol, ul, li, fieldset, form, label, legend, caption {
    margin: 0;
    padding: 0;
    border: 0;
    outline: 0;
    font-size: 100%;
    vertical-align: baseline;
    background: transparent;
}
html{
	width: 100%;}
@font-face {
	font-family:"San Francisco";
	src: url("San Francisco.otf");}
@font-face {
	font-family:"San Francisco Bold";
	src: url("San Francisco Bold.otf");}
body {
	background-color: white;
	color: black;
	font-family: "San Francisco";
	margin:0;}
ol.topNavOl{
	list-style-type: none;
	text-align: center;
	background-color: black;
	padding: 8px;} 	
li.topNav{
	display: inline;
	padding: 12px;
	font-size: 12px;}
li.classname{
	display: inline;
	color: white;
	font-size: 13px;
	font-family: "San Francisco Bold";}
a:link.nav {
	color:white; 
	text-decoration: none;}
a:visited.nav {
	color: #D3D3D3;}
a:link.gridItem {
	color:black; 
	text-decoration: none;}
a:visited.gridItem {
	color: gray;}
a:link.ytLink {
	color:black;
	display: inline;}
a:visited.ytLink {
	color: gray;}
.center_image {
	display: block;
	margin-left: auto;
	margin-right: auto;
	border-radius: 15px; }
.div_text{
	display: inline;
	text-align: left;
	}
.grid{
	display: grid;
	grid-template-columns: auto auto auto auto;
	grid-row-gap: 5px;
	}
.gridItem{
	border: 1px solid black;
    border-radius: 5px;
    float: left;
	padding: 1em;
    width: 80%;
	text-align: center;}
.gif{
	display: inline;
	float: left;
	margin-left: 20px;
	margin-right: 20px;}
footer{
	position: fixed;
	width: 100%;
	text-align: center;
	bottom: 0;
	left: 0;
	padding: 0px;
	background-color: black;
	color: white;
	font-family: "San Francisco";
	}
h1{
	font-family: "San Francisco Bold";
	font-size: 25px;
	text-align: center;}